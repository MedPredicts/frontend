# Copy to .env.local, then restart Vite. These values are public browser configuration.
VITE_API_MODE=real
# Empty uses /api on this origin (proxied by Vite in development).
# For a separate API origin, set its full URL and configure backend CORS.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000
# Server-only Vite development proxy target; never contains credentials.
API_PROXY_TARGET=http://127.0.0.1:8080
